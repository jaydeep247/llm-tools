# Production / server environment template

# Runtime mode
NODE_ENV=production

# App secrets
JWT_SECRET=replace-with-strong-32-plus-char-secret
COOKIE_SECRET=replace-with-strong-32-plus-char-secret

# External/managed infrastructure endpoints
RABBITMQ_URL=amqps://user:password@your-rabbitmq-host/vhost
REDIS_URL=rediss://default:password@your-redis-host:6380

# Set to true only if you intentionally run RabbitMQ/Redis locally in production
ALLOW_LOCAL_INFRA_IN_PROD=false

# Backend networking
BACKEND_PORT=3004
FRONTEND_PORT=80
CORS_ORIGINS=https://your-frontend-domain

# Data stores
MONGO_URI=mongodb://your-mongo-host:27017
MONGO_DB_NAME=seo_crawler

# Optional app settings
MAX_CRAWL_PAGES=3000
S3_ENABLED=true
S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=colytics-stage
S3_REGION=sfo3

# AI Keys
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me

# DataForSEO
DATAFORSEO_LOGIN=replace-me
DATAFORSEO_PASSWORD=replace-me
