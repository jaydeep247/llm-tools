# ====================================
# AEO API - Environment Configuration
# ====================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ====================================

# ====================================
# Server Configuration
# ====================================
HOST=localhost
PORT=8001
DEBUG=False

# ====================================
# AI API Keys
# ====================================
# OpenAI (Required for AEO analysis and schema generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gemini (Optional - for multi-AI analysis)
GEMINI_API_KEY=your-gemini-api-key-here

# Claude (Optional - for multi-AI analysis)
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# ====================================
# DataForSEO API (Backlink Analysis)
# ====================================
DATAFORSEO_USERNAME=your_dataforseo_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password
