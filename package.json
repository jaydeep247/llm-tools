{
  "name": "contentlytics-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd node-backend && npm run dev",
    "dev:py": "cd py-backend && python run.py",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "install:all": "cd frontend && npm install && cd ../node-backend && npm install && cd ../py-backend && pip install -r requirements.txt",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd node-backend && npm run build"
  },
  "description": "Contentlytics - Content Analytics & AEO Intelligence Platform (Monorepo)",
  "keywords": [
    "contentlytics",
    "aeo",
    "seo",
    "content-analytics",
    "crawler"
  ],
