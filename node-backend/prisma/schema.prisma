// AUDIT TABLES
// ============================================

model AuditSchedule {
  id             Int       @id @default(autoincrement())
  name           String    @db.Text
  description    String    @db.Text
  urls           String    @db.Text // JSON string
  device         String    @db.Text
  cronExpression String    @map("cron_expression") @db.Text
  enabled        Boolean   @default(true)
  userId         Int?      @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastRun        DateTime? @map("last_run") @db.Timestamptz
  nextRun        DateTime? @map("next_run") @db.Timestamptz
  totalRuns      Int       @default(0) @map("total_runs")
  successfulRuns Int       @default(0) @map("successful_runs")
  failedRuns     Int       @default(0) @map("failed_runs")

  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions AuditExecution[]

  @@map("audit_schedules")
}

model AuditExecution {
  id             Int       @id @default(autoincrement())
  scheduleId     Int       @map("schedule_id")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  status         String    @default("running") @db.Text
  errorMessage   String?   @map("error_message") @db.Text
  urlsProcessed  Int       @default(0) @map("urls_processed")
  urlsSuccessful Int       @default(0) @map("urls_successful")
  urlsFailed     Int       @default(0) @map("urls_failed")
  duration       Int       @default(0)

  schedule AuditSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("audit_executions")
}

model AuditResult {
  id               Int      @id @default(autoincrement())
  url              String   @db.Text
  device           String   @db.Text
  runAt            DateTime @default(now()) @map("run_at") @db.Timestamptz
  lcpMs            Int?     @map("lcp_ms")
  tbtMs            Int?     @map("tbt_ms")
  cls              Float?
  fcpMs            Int?     @map("fcp_ms")
  ttfbMs           Int?     @map("ttfb_ms")
  fcp              Decimal? @db.Decimal(10, 2)
  ttfb             Decimal? @db.Decimal(10, 2)
  fid              Decimal? @db.Decimal(10, 2)
  deviceType       String?  @default("desktop") @map("device_type") @db.VarChar(20)
  performanceScore Int?     @map("performance_score")
  psiReportUrl     String?  @map("psi_report_url") @db.Text
  metricsJson      String?  @map("metrics_json") @db.Text
  rawJson          String?  @map("raw_json") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  sessionId        Int?     @map("session_id")
  status           String   @default("pending") @db.Text
  progress         Int      @default(0)

  @@index([url], map: "idx_audit_results_url")
  @@map("audit_results")
}

