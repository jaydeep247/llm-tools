  @@index([url], map: "idx_aeo_results_url")
  @@map("aeo_results")
}

model AeoSchedule {
  id                 Int       @id @default(autoincrement())
  name               String    @db.Text
  description        String    @db.Text
  startUrl           String    @map("start_url") @db.Text
  allowSubdomains    Boolean   @default(true) @map("allow_subdomains")
  runAudits          Boolean   @default(false) @map("run_audits")
  auditDevice        String    @default("desktop") @map("audit_device") @db.Text
  captureLinkDetails Boolean   @default(false) @map("capture_link_details")
  cronExpression     String    @map("cron_expression") @db.Text
  enabled            Boolean   @default(true)
  userId             Int?      @map("user_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastRun            DateTime? @map("last_run") @db.Timestamptz
  nextRun            DateTime? @map("next_run") @db.Timestamptz
  totalRuns          Int       @default(0) @map("total_runs")
  successfulRuns     Int       @default(0) @map("successful_runs")
  failedRuns         Int       @default(0) @map("failed_runs")
  lastAeoScore       Float?    @map("last_aeo_score")
  averageAeoScore    Float?    @map("average_aeo_score")

  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions AeoExecution[]

  @@map("aeo_schedules")
}

model AeoExecution {
  id              Int       @id @default(autoincrement())
  scheduleId      Int       @map("schedule_id")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  status          String    @default("running") @db.Text
  pagesAnalyzed   Int       @default(0) @map("pages_analyzed")
  averageAeoScore Float?    @map("average_aeo_score")
  duration        Int?
  errorMessage    String?   @map("error_message") @db.Text

  schedule AeoSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("aeo_executions")
}

model AeoAnalysisResult {
  id                Int      @id @default(autoincrement())
  sessionId         Int?     @map("session_id")
  userId            Int?     @map("user_id")
  url               String   @db.Text
  grade             String?  @db.Text
  gradeColor        String?  @map("grade_color") @db.Text
  overallScore      Float?   @map("overall_score")
  moduleScores      String?  @map("module_scores") @db.Text // JSON string
  moduleWeights     String?  @map("module_weights") @db.Text // JSON string
  detailedAnalysis  String?  @map("detailed_analysis") @db.Text // JSON string
  structuredData    String?  @map("structured_data") @db.Text // JSON string
  recommendations   String?  @map("recommendations") @db.Text // JSON string
  errors            String?  @db.Text
  warnings          String?  @db.Text
  metrics           String?  @db.Text // JSON string for metrics (entity_presence_ratio, structured_data_completeness, readability_score)
  analysisTimestamp DateTime @default(now()) @map("analysis_timestamp") @db.Timestamptz
