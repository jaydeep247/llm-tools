// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER TABLES
// ============================================

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.Text
  passwordHash String    @map("password_hash") @db.Text
  name         String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLogin    DateTime? @map("last_login") @db.Timestamptz
  isActive     Boolean   @default(true) @map("is_active")
  role         String    @default("user") @db.Text

  // Relations
  userSettings       UserSettings?
  userUsage          UserUsage[]
  projects           Project[]
  crawlSessions      CrawlSession[]
  crawlSchedules     CrawlSchedule[]
  sessionShares      SessionShare[]
  auditSchedules     AuditSchedule[]
  aeoSchedules       AeoSchedule[]
  aeoAnalysisResults AeoAnalysisResult[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserSettings {
  userId             Int     @id @map("user_id")
  openaiApiKey       String? @map("openai_api_key") @db.Text
  psiApiKey          String? @map("psi_api_key") @db.Text
  maxCrawlsPerDay    Int     @default(100) @map("max_crawls_per_day")
  emailNotifications Boolean @default(true) @map("email_notifications")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserUsage {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  actionType  String   @map("action_type") @db.Text
  timestamp   DateTime @default(now()) @db.Timestamptz
  creditsUsed Int      @default(1) @map("credits_used")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_usage_user_id")
  @@map("user_usage")
}

// ============================================
// PROJECT TABLES
// ============================================

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.Text
  description String?   @db.Text
  userId      Int       @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  isActive    Boolean   @default(true) @map("is_active")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crawlSessions CrawlSession[]

  @@index([userId], map: "idx_projects_user_id")
  @@index([userId, isActive], map: "idx_projects_user_active")
  @@map("projects")
}

// ============================================
// CRAWL SESSION TABLES
// ============================================

model CrawlSession {
  id               Int       @id @default(autoincrement())
  projectId        String    @map("project_id") @db.Uuid
  startUrl         String    @map("start_url") @db.Text
  allowSubdomains  Boolean   @default(true) @map("allow_subdomains")
  maxConcurrency   Int       @map("max_concurrency")
  mode             String    @db.Text
  scheduleId       Int?      @map("schedule_id")
  userId           Int?      @map("user_id")
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  totalPages       Int       @default(0) @map("total_pages")
  totalResources   Int       @default(0) @map("total_resources")
  duration         Int       @default(0)
  status           String    @default("running") @db.Text
  maxDepth         Int?      @default(3) @map("max_depth")
  maxPages         Int?      @default(100) @map("max_pages")
  respectRobotsTxt Boolean?  @default(true) @map("respect_robots_txt")
  userAgent        String?   @map("user_agent") @db.Text
  errorMessage     String?   @map("error_message") @db.Text
  pagesCrawled     Int?      @default(0) @map("pages_crawled")

  // Relations
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id])
  pages               Page[]
  resources           Resource[]
  links               Link[]
  sitemapDiscoveries  SitemapDiscovery[]
  sitemapUrls         SitemapUrl[]
  sessionShares       SessionShare[]
  crawlLogs           CrawlLog[]
  scheduleExecutions  ScheduleExecution[]
  aeoResults          AeoResult[]
  aeoAnalysisResults  AeoAnalysisResult[]
  pageMetrics         PageMetric[]
  wordcountAnalyses   WordcountAnalysis[]
  contentFingerprints ContentFingerprint[]
  similarityIndices   SimilarityIndex[]
  serpSnapshots       SerpSnapshot[]

  @@index([projectId], map: "idx_crawl_sessions_project_id")
  @@index([userId], map: "idx_crawl_sessions_user_id")
  @@index([projectId, status], map: "idx_crawl_sessions_project_status")
  @@map("crawl_sessions")
}

model SerpSnapshot {
  id               Int      @id @default(autoincrement())
  keyword          String   @db.Text
  targetDomain     String   @map("target_domain") @db.Text
  normalizedDomain String   @map("normalized_domain") @db.Text
  searchEngine     String   @default("google") @map("search_engine") @db.Text
  location         String   @db.Text
  device           String   @db.VarChar(20)
  maxResults       Int      @map("max_results")
  runAt            DateTime @default(now()) @map("run_at") @db.Timestamptz
  position         Int?     
  rankingUrl       String?  @map("ranking_url") @db.Text
  rankStatus       String   @default("ranked") @map("rank_status") @db.VarChar(20)
  change           Int?
  changeLabel      String?  @map("change_label") @db.VarChar(16)
  intent           String   @db.VarChar(50)
  topCompetitors   Json     @map("top_competitors")
  serpFeatures     Json     @map("serp_features")
  serp             Json
  sessionId        Int?     @map("session_id")

  session CrawlSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([keyword, normalizedDomain, location, device, runAt], map: "idx_serp_keyword_domain_time")
  @@map("serp_snapshots")
}

model SessionShare {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  userId     Int      @map("user_id")
  accessedAt DateTime @default(now()) @map("accessed_at") @db.Timestamptz

  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_shares")
}

model CrawlSchedule {
  id              Int       @id @default(autoincrement())
  name            String    @db.Text
  description     String    @db.Text
  startUrl        String    @map("start_url") @db.Text
  allowSubdomains Boolean   @default(true) @map("allow_subdomains")
  maxConcurrency  Int       @map("max_concurrency")
  mode            String    @db.Text
  cronExpression  String    @map("cron_expression") @db.Text
  enabled         Boolean   @default(true)
  userId          Int?      @map("user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastRun         DateTime? @map("last_run") @db.Timestamptz
  nextRun         DateTime? @map("next_run") @db.Timestamptz
  totalRuns       Int       @default(0) @map("total_runs")
  successfulRuns  Int       @default(0) @map("successful_runs")
  failedRuns      Int       @default(0) @map("failed_runs")

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleExecutions ScheduleExecution[]

  @@index([userId], map: "idx_crawl_schedules_user_id")
  @@map("crawl_schedules")
}

model ScheduleExecution {
  id             Int       @id @default(autoincrement())
  scheduleId     Int       @map("schedule_id")
  sessionId      Int       @map("session_id")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  status         String    @default("running") @db.Text
  errorMessage   String?   @map("error_message") @db.Text
  pagesCrawled   Int       @default(0) @map("pages_crawled")
  resourcesFound Int       @default(0) @map("resources_found")
  duration       Int       @default(0)

  schedule CrawlSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  session  CrawlSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("schedule_executions")
}

model CrawlLog {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  message   String   @db.Text
  level     String   @default("info") @db.Text
  timestamp DateTime @default(now()) @db.Timestamptz

  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_crawl_logs_session_id")
  @@map("crawl_logs")
}

// ============================================
// PAGE TABLES
// ============================================

model Page {
  id                                Int      @id @default(autoincrement())
  sessionId                         Int      @map("session_id")
  url                               String   @db.Text
  title                             String   @db.Text
  titleLength                       Int      @default(0) @map("title_length")
  titlePixelWidth                   Int?     @map("title_pixel_width")
  description                       String   @db.Text
  descriptionLength                 Int      @default(0) @map("description_length")
  descriptionPixelWidth             Int?     @map("description_pixel_width")
  contentType                       String   @map("content_type") @db.Text
  lastModified                      String?  @map("last_modified") @db.Text
  statusCode                        Int      @map("status_code")
  responseTime                      Int      @map("response_time")
  wordCount                         Int      @default(0) @map("word_count")
  sentenceCount                     Int?     @map("sentence_count")
  averageWordsPerSentence           Decimal? @map("average_words_per_sentence") @db.Decimal(10, 2)
  fleschReadingEase                 Decimal? @map("flesch_reading_ease_score") @db.Decimal(10, 2)
  readabilityLevel                  String?  @map("readability_level") @db.Text
  textToHtmlRatio                   Decimal? @map("text_to_html_ratio") @db.Decimal(5, 2)
  crawlDepth                        Int      @default(0) @map("crawl_depth")
  folderDepth                       Int      @default(0) @map("folder_depth")
  sizeBytes                         Int?     @map("size_bytes")
  timestamp                         DateTime @default(now()) @db.Timestamptz
  success                           Boolean
  errorMessage                      String?  @map("error_message") @db.Text
  linkScore                         Decimal? @map("link_score") @db.Decimal(5, 2)
  canonicalUrl                      String?  @map("canonical_url") @db.Text
  amphtmlUrl                        String?  @map("amphtml_url") @db.Text
  mobileAlternateUrl                String?  @map("mobile_alternate_url") @db.Text
  indexable                         Boolean? @default(true)
  indexabilityStatus                String?  @map("indexability_status") @db.VarChar(100)
  metaRobots                        String?  @map("meta_robots") @db.Text
  xRobotsTag                        String?  @map("x_robots_tag") @db.Text
  metaRefresh                       String?  @map("meta_refresh") @db.Text
  transferredBytes                  BigInt?  @map("transferred_bytes")
  totalTransferredBytes             BigInt?  @map("total_transferred_bytes")
  co2Mg                             Decimal? @map("co2_mg") @db.Decimal(10, 4)
  carbonRating                      String?  @map("carbon_rating") @db.VarChar(5)
  relNext                           String?  @map("rel_next") @db.Text
  relPrev                           String?  @map("rel_prev") @db.Text
  httpRelNext                       String?  @map("http_rel_next") @db.Text
  httpRelPrev                       String?  @map("http_rel_prev") @db.Text
  metaKeywords                      String?  @map("meta_keywords") @db.Text
  metaKeywordsLength                Int?     @map("meta_keywords_length")
  headingTags                       String?  @map("heading_tags") @db.Text
  spellingErrors                    Int      @default(0) @map("spelling_errors")
  grammarErrors                     Int      @default(0) @map("grammar_errors")
  redirectUrl                       String?  @map("redirect_url") @db.Text
  redirectType                      String?  @map("redirect_type") @db.VarChar(50)
  cookies                           String?  @db.Text
  language                          String?  @db.VarChar(10)
  httpVersion                       String?  @map("http_version") @db.VarChar(20)
  closestSemanticallySimilarAddress String?  @map("closest_semantically_similar_address") @db.Text
  semanticSimilarityScore           Decimal? @map("semantic_similarity_score") @db.Decimal(3, 2)
  noSemanticallySimilar             Int      @default(0) @map("no_semantically_similar")
  semanticRelevanceScore            Decimal? @map("semantic_relevance_score") @db.Decimal(3, 2)
  urlEncodedAddress                 String?  @map("url_encoded_address") @db.Text
  contentHash                       String?  @map("content_hash") @db.VarChar(64)
  closestDuplicateUrl               String?  @map("closest_duplicate_url") @db.Text
  closestDuplicateSimilarity        Decimal? @map("closest_duplicate_similarity") @db.Decimal(5, 4)
  nearDuplicateCount                Int      @default(0) @map("near_duplicate_count")
  uniqueExternalOutlinks            Int      @default(0) @map("unique_external_outlinks")
  uniqueExternalJsOutlinks          Int      @default(0) @map("unique_external_js_outlinks")
  uniqueOutlinks                    Int?     @default(0) @map("unique_outlinks")
  uniqueJsOutlinks                  Int?     @default(0) @map("unique_js_outlinks")
  metaDescription                   String?  @map("meta_description") @db.Text
  ogTitle                           String?  @map("og_title") @db.Text
  ogDescription                     String?  @map("og_description") @db.Text
  ogImage                           String?  @map("og_image") @db.Text

  // Relations
  session             CrawlSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resources           Resource[]
  sourceLinks         Link[]               @relation("SourcePage")
  targetLinks         Link[]               @relation("TargetPage")
  pageMetrics         PageMetric[]
  wordcountAnalyses   WordcountAnalysis[]
  contentFingerprints ContentFingerprint[]
  sourceSimilarities  SimilarityIndex[]    @relation("SourcePage")
  targetSimilarities  SimilarityIndex[]    @relation("TargetPage")

  @@index([sessionId], map: "idx_pages_session_id")
  @@index([url], map: "idx_pages_url")
  @@index([linkScore(sort: Desc)], map: "idx_pages_link_score")
  @@index([sessionId, linkScore(sort: Desc)], map: "idx_pages_session_link_score")
  @@index([canonicalUrl], map: "idx_pages_canonical_url")
  @@index([closestSemanticallySimilarAddress], map: "idx_pages_closest_semantically_similar_address")
  @@index([semanticSimilarityScore(sort: Desc)], map: "idx_pages_semantic_similarity_score")
  @@index([noSemanticallySimilar(sort: Desc)], map: "idx_pages_no_semantically_similar")
  @@index([semanticRelevanceScore(sort: Desc)], map: "idx_pages_semantic_relevance_score")
  @@index([sessionId, semanticSimilarityScore(sort: Desc)], map: "idx_pages_session_semantic_similarity")
  @@index([urlEncodedAddress], map: "idx_pages_url_encoded_address")
  @@index([contentHash], map: "idx_pages_content_hash")
  @@index([sessionId, contentHash], map: "idx_pages_session_content_hash")
  @@index([nearDuplicateCount(sort: Desc)], map: "idx_pages_near_duplicate_count")
  @@index([closestDuplicateSimilarity(sort: Desc)], map: "idx_pages_closest_duplicate_similarity")
  @@index([uniqueExternalOutlinks(sort: Desc)], map: "idx_pages_unique_external_outlinks")
  @@index([uniqueExternalJsOutlinks(sort: Desc)], map: "idx_pages_unique_external_js_outlinks")
  @@index([uniqueOutlinks(sort: Desc)], map: "idx_pages_unique_outlinks")
  @@index([uniqueJsOutlinks(sort: Desc)], map: "idx_pages_unique_js_outlinks")
  @@index([indexable], map: "idx_pages_indexable")
  @@index([indexabilityStatus], map: "idx_pages_indexability_status")
  @@index([metaRobots], map: "idx_pages_meta_robots")
  @@index([xRobotsTag], map: "idx_pages_x_robots_tag")
  @@index([metaRefresh], map: "idx_pages_meta_refresh")
  @@index([relNext], map: "idx_pages_rel_next")
  @@index([relPrev], map: "idx_pages_rel_prev")
  @@index([httpRelNext], map: "idx_pages_http_rel_next")
  @@index([httpRelPrev], map: "idx_pages_http_rel_prev")
  @@index([textToHtmlRatio], map: "idx_pages_text_to_html_ratio")
  @@index([titlePixelWidth], map: "idx_pages_title_pixel_width")
  @@index([descriptionPixelWidth], map: "idx_pages_description_pixel_width")
  @@index([fleschReadingEase(sort: Desc)], map: "idx_pages_flesch_reading_ease_score")
  @@index([readabilityLevel], map: "idx_pages_readability_level")
  @@index([metaKeywordsLength], map: "idx_pages_meta_keywords_length")
  @@index([crawlDepth], map: "idx_pages_crawl_depth")
  @@index([folderDepth], map: "idx_pages_folder_depth")
  @@index([averageWordsPerSentence(sort: Desc)], map: "idx_pages_average_words_per_sentence")
  @@index([sentenceCount(sort: Desc)], map: "idx_pages_sentence_count")
  @@index([sizeBytes(sort: Desc)], map: "idx_pages_size_bytes")
  @@index([spellingErrors(sort: Desc)], map: "idx_pages_spelling_errors")
  @@index([grammarErrors(sort: Desc)], map: "idx_pages_grammar_errors")
  @@index([redirectUrl], map: "idx_pages_redirect_url")
  @@index([redirectType], map: "idx_pages_redirect_type")
  @@index([language], map: "idx_pages_language")
  @@index([httpVersion], map: "idx_pages_http_version")
  @@index([mobileAlternateUrl], map: "idx_pages_mobile_alternate_url")
  @@map("pages")
}

model Resource {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @map("session_id")
  pageId       Int?     @map("page_id")
  url          String   @db.Text
  resourceType String   @map("resource_type") @db.Text
  title        String   @db.Text
  description  String   @db.Text
  contentType  String   @map("content_type") @db.Text
  statusCode   Int?
  responseTime Int?
  timestamp    DateTime @default(now()) @db.Timestamptz

  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  page    Page?        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([sessionId, url])
  @@index([sessionId], map: "idx_resources_session_id")
  @@map("resources")
}

model Link {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @map("session_id")
  sourcePageId Int      @map("source_page_id")
  sourceUrl    String   @map("source_url") @db.Text
  targetUrl    String   @map("target_url") @db.Text
  targetPageId Int?     @map("target_page_id")
  isInternal   Boolean  @map("is_internal")
  anchorText   String?  @map("anchor_text") @db.Text
  xpath        String?  @db.Text
  position     String?  @db.Text
  rel          String?  @db.Text
  nofollow     Boolean  @default(false)
  isJsRendered Boolean  @default(false) @map("is_js_rendered")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  session    CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourcePage Page         @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page?        @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: SetNull)

  @@index([sessionId], map: "idx_links_session_id")
  @@index([isJsRendered], map: "idx_links_js_rendered")
  @@map("links")
}

model SitemapDiscovery {
  id             Int     @id @default(autoincrement())
  sessionId      Int     @map("session_id")
  sitemapUrl     String  @map("sitemap_url") @db.Text
  discoveredUrls Int     @map("discovered_urls")
  lastModified   String  @map("last_modified") @db.Text
  success        Boolean
  errorMessage   String? @map("error_message") @db.Text

  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("sitemap_discoveries")
}

model SitemapUrl {
  id              Int      @id @default(autoincrement())
  sessionId       Int      @map("session_id")
  url             String   @db.Text
  lastModified    String?  @map("last_modified") @db.Text
  changeFrequency String?  @map("change_frequency") @db.Text
  priority        String?  @db.Text
  discoveredAt    DateTime @default(now()) @map("discovered_at") @db.Timestamptz
  crawled         Boolean  @default(false)

  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_sitemap_urls_session_id")
  @@map("sitemap_urls")
}

model SeoCache {
  id         Int      @id @default(autoincrement())
  url        String   @unique @db.Text
  parentText String?  @map("parent_text") @db.Text
  keywords   String   @db.Text
  language   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz

  @@map("seo_cache")
}

// ============================================
// PAGE METRICS & ANALYSIS TABLES
// ============================================

model PageMetric {
  id                            Int      @id @default(autoincrement())
  pageId                        Int      @map("page_id")
  sessionId                     Int      @map("session_id")
  titleStatus                   String?  @map("title_status") @db.VarChar(20)
  duplicateTitleCount           Int?     @map("duplicate_title_count")
  duplicateWith                 String?  @map("duplicate_with") @db.Text
  metaDescriptionStatus         String?  @map("meta_description_status") @db.VarChar(20)
  duplicateMetaDescriptionCount Int?     @map("duplicate_meta_description_count")
  duplicateMetaDescriptionWith  String?  @map("duplicate_meta_description_with") @db.Text
  canonicalUrl                  String?  @map("canonical_url") @db.Text
  canonicalValidationStatus     String?  @map("canonical_validation_status") @db.VarChar(20)
  canonicalValidationMessage    String?  @map("canonical_validation_message") @db.Text
  tableCount                    Int?     @map("table_count")
  tableData                     String?  @map("table_data") @db.Text
  hasTables                     Boolean? @map("has_tables")
  faqCount                      Int?     @map("faq_count")
  faqData                       String?  @map("faq_data") @db.Text
  hasFaqs                       Boolean? @map("has_faqs")
  faqScore                      Int?     @map("faq_score")
  faqDetectionMethod            String?  @map("faq_detection_method") @db.VarChar(50)
  faqSchemaPresent              Boolean? @map("faq_schema_present")
  hasMixedContent               Boolean? @map("has_mixed_content")
  mixedContentSeverity          String?  @map("mixed_content_severity") @db.VarChar(20)
  mixedContentData              String?  @map("mixed_content_data") @db.Text
  activeMixedContentCount       Int?     @map("active_mixed_content_count")
  passiveMixedContentCount      Int?     @map("passive_mixed_content_count")
  totalInsecureResources        Int?     @map("total_insecure_resources")
  headerStructureData           String?  @map("header_structure_data") @db.Text
  headerStructureIssues         String?  @map("header_structure_issues") @db.Text
  viewportPresent               Boolean? @map("viewport_present")
  viewportContent               String?  @map("viewport_content") @db.Text
  viewportStatus                String?  @map("viewport_status") @db.VarChar(20)
  structuredDataPresent         Boolean? @map("structured_data_present")
  structuredDataFormat          String?  @map("structured_data_format") @db.VarChar(50)
  structuredDataTypes           String?  @map("structured_data_types") @db.Text
  structuredDataPriorityType    String?  @map("structured_data_priority_type") @db.VarChar(100)
  pageSizeBytes                 Int?     @map("page_size_bytes")
  pageSizeStatus                String?  @map("page_size_status") @db.VarChar(20)
  htmlSizeBytes                 Int?     @map("html_size_bytes")
  htmlSizeStatus                String?  @map("html_size_status") @db.VarChar(20)
  totalResourceSizeBytes        Int?     @map("total_resource_size_bytes")
  resourceSizeBreakdown         String?  @map("resource_size_breakdown") @db.Text
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([pageId, sessionId])
  @@index([pageId], map: "idx_page_metrics_page_id")
  @@index([sessionId], map: "idx_page_metrics_session_id")
  @@index([titleStatus], map: "idx_page_metrics_title_status")
  @@index([sessionId, titleStatus], map: "idx_page_metrics_session_title_status")
  @@index([duplicateTitleCount(sort: Desc)], map: "idx_page_metrics_duplicate_title_count")
  @@index([metaDescriptionStatus], map: "idx_page_metrics_meta_description_status")
  @@index([sessionId, metaDescriptionStatus], map: "idx_page_metrics_session_meta_description_status")
  @@index([duplicateMetaDescriptionCount(sort: Desc)], map: "idx_page_metrics_duplicate_meta_description_count")
  @@index([canonicalValidationStatus], map: "idx_page_metrics_canonical_validation_status")
  @@index([sessionId, canonicalValidationStatus], map: "idx_page_metrics_session_canonical_status")
  @@index([hasTables], map: "idx_page_metrics_has_tables")
  @@index([sessionId, hasTables], map: "idx_page_metrics_session_has_tables")
  @@index([hasFaqs], map: "idx_page_metrics_has_faqs")
  @@index([sessionId, hasFaqs], map: "idx_page_metrics_session_has_faqs")
  @@index([hasMixedContent], map: "idx_page_metrics_has_mixed_content")
  @@index([mixedContentSeverity], map: "idx_page_metrics_mixed_content_severity")
  @@index([sessionId, hasMixedContent], map: "idx_page_metrics_session_mixed_content")
  @@index([viewportPresent], map: "idx_page_metrics_viewport_present")
  @@index([viewportStatus], map: "idx_page_metrics_viewport_status")
  @@index([structuredDataPresent], map: "idx_page_metrics_structured_data_present")
  @@index([pageSizeStatus], map: "idx_page_metrics_page_size_status")
  @@index([htmlSizeStatus], map: "idx_page_metrics_html_size_status")
  @@index([pageSizeBytes(sort: Desc)], map: "idx_page_metrics_page_size_bytes")
  @@index([htmlSizeBytes(sort: Desc)], map: "idx_page_metrics_html_size_bytes")
  @@index([totalResourceSizeBytes(sort: Desc)], map: "idx_page_metrics_total_resource_size_bytes")
  @@map("page_metrics")
}

model WordcountAnalysis {
  id                        Int      @id @default(autoincrement())
  pageId                    Int      @map("page_id")
  sessionId                 Int      @map("session_id")
  totalWordCount            Int?     @map("total_word_count")
  visibleWordCount          Int?     @map("visible_word_count")
  uniqueWordCount           Int?     @map("unique_word_count")
  textToHtmlRatio           Decimal? @map("text_to_html_ratio") @db.Decimal(5, 2)
  sentenceCount             Int?     @map("sentence_count")
  paragraphCount            Int?     @map("paragraph_count")
  averageSentenceLength     Decimal? @map("average_sentence_length") @db.Decimal(5, 2)
  averageParagraphLength    Decimal? @map("average_paragraph_length") @db.Decimal(5, 2)
  keywordDensity            Decimal? @map("keyword_density") @db.Decimal(5, 2)
  thinContent               Boolean? @map("thin_content")
  thinContentReason         String?  @map("thin_content_reason") @db.Text
  duplicateContent          Boolean? @map("duplicate_content")
  duplicateWithUrls         Json?    @map("duplicate_with_urls") @db.JsonB
  sectionWordCountMapping   Json?    @map("section_word_count_mapping") @db.JsonB
  sectionWordCountBreakdown Json?    @map("section_word_count_breakdown") @db.JsonB
  headingWordCountMapping   Json?    @map("heading_word_count_mapping") @db.JsonB
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([pageId, sessionId])
  @@index([pageId], map: "idx_wordcount_analysis_page_id")
  @@index([sessionId], map: "idx_wordcount_analysis_session_id")
  @@index([totalWordCount(sort: Desc)], map: "idx_wordcount_analysis_total_word_count")
  @@index([visibleWordCount(sort: Desc)], map: "idx_wordcount_analysis_visible_word_count")
  @@index([sessionId, visibleWordCount(sort: Desc)], map: "idx_wordcount_analysis_session_word_count")
  @@index([thinContent], map: "idx_wordcount_analysis_thin_content")
  @@index([duplicateContent], map: "idx_wordcount_analysis_duplicate_content")
  @@map("wordcount_analysis")
}

model ContentFingerprint {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  sessionId   Int      @map("session_id")
  url         String   @db.Text
  contentHash String   @map("content_hash") @db.Text
  simhash     String   @db.Text
  wordCount   Int      @default(0) @map("word_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  session CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([pageId, sessionId])
  @@index([sessionId], map: "idx_content_fingerprints_session")
  @@index([pageId], map: "idx_content_fingerprints_page")
  @@index([simhash], map: "idx_content_fingerprints_simhash")
  @@index([contentHash], map: "idx_content_fingerprints_hash")
  @@map("content_fingerprints")
}

model SimilarityIndex {
  id              Int      @id @default(autoincrement())
  sourcePageId    Int      @map("source_page_id")
  targetPageId    Int      @map("target_page_id")
  sessionId       Int      @map("session_id")
  similarityScore Decimal  @map("similarity_score") @db.Decimal(5, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  sourcePage Page         @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page         @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)
  session    CrawlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId, sessionId])
  @@index([sourcePageId, similarityScore(sort: Desc)], map: "idx_similarity_source")
  @@index([targetPageId], map: "idx_similarity_target")
  @@index([sessionId], map: "idx_similarity_session")
  @@index([similarityScore(sort: Desc)], map: "idx_similarity_score")
  @@map("similarity_index")
}

