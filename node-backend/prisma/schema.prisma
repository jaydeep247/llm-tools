model AeoResult {
  id                  Int       @id @default(autoincrement())
  url                 String    @db.Text
  sessionId           Int?      @unique @map("session_id")
  scoreOpenai         Int       @default(0) @map("score_openai")
  scoreClaude         Int       @default(0) @map("score_claude")
  scoreGemini         Int       @default(0) @map("score_gemini")
  consistency         Int       @default(0)
  scoreEntityCoverage Int       @default(0) @map("score_entity_coverage")
  entitiesExpected    Json      @default("[]") @map("entities_expected") @db.JsonB
  entitiesObserved    Json      @default("[]") @map("entities_observed") @db.JsonB
  entitiesMissing     Json      @default("[]") @map("entities_missing") @db.JsonB
  brandMetrics        Json?     @map("brand_metrics") @db.JsonB
  analyzedPagesCount  Int       @default(0) @map("analyzed_pages_count")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
