# SEO Worker Dockerfile - Lightweight production image
FROM node:20-alpine AS builder

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}

WORKDIR /app

# Update Alpine packages to fix security vulnerabilities (CVE-2025-60876)
RUN apk update && apk upgrade --no-cache

# Copy package files
COPY package*.json ./

# Install all dependencies (needed for build)
RUN npm ci

# Copy Prisma schema and config files
COPY prisma ./prisma
COPY prisma.config.ts ./

# Generate Prisma Client
# DATABASE_URL must come from the environment (.env or build-time env/args)
RUN npm run prisma:generate

# Copy source code
COPY . .

# Build TypeScript application
RUN npm run build

# Production stage
FROM node:20-alpine

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}

WORKDIR /app

# Update Alpine packages to fix security vulnerabilities (CVE-2025-60876)
RUN apk update && apk upgrade --no-cache

# Copy only package files for production dependencies
COPY package*.json ./

# Install production dependencies only
RUN npm ci --only=production

# Copy Prisma schema and config (needed for runtime and client generation)
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./

# Regenerate Prisma Client in production stage
# This ensures @prisma/client can properly resolve to the generated client
RUN npm run prisma:generate

# Copy the built backend dist files (including SEO worker)
COPY --from=builder /app/dist ./dist
# Copy config directory (needed for Redis configuration)
COPY --from=builder /app/config ./config

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership of app directory
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Add healthcheck (fixes CIS-DI-0006)
# Note: Worker processes may not have HTTP endpoints, so we check if process is running
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD ps aux | grep -q "[s]eo-worker.js" || exit 1

# Command to run the SEO worker
CMD ["node", "dist/redis/seo/seo-worker.js"]

# No port exposure - internal service only
