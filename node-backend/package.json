{
  "name": "contentlytics",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "crawl": "tsx src/crawler-cli.ts",
    "seo:worker": "tsx src/redis/seo/seo-worker.ts",
    "seo:cli": "tsx src/redis/seo/seo-cli.ts",
    "audit:worker": "tsx src/audit/audit-worker.ts",
    "db:init": "tsx scripts/initDb.ts",
    "db:migrate": "tsx scripts/crawlerTableMigration.ts",
    "db:seed:admin": "tsx scripts/seedAdmin.ts",
    "clear:sessions": "echo 'clear-all-sessions.ts removed - use db:init instead'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate"
  },
  "keywords": [
    "contentlytics",
    "aeo",
    "seo",
    "content-analytics",
    "crawler"
  ],
  "author": "",
