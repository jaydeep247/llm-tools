  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/xml2js": "^0.4.14",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crawlee": "^3.14.1",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.6",
    "normalize-url": "^8.1.0",
    "prisma": "^6.19.2",
    "puppeteer": "^22.0.0",
    "xml2js": "^0.6.2"
  },
