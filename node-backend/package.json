    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^7.0.1",
    "nodemon": "^3.1.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
