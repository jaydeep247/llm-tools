# Node.js Backend API
API_BASE_URL=http://localhost:3000/api/v1

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=seo_crawler

# Poller Configuration
POLL_INTERVAL=5
MAX_CONCURRENT_JOBS=2

# Worker Identity
WORKER_ID=python-worker-1
WORKER_API_KEY=your-secure-shared-key-here

# Logging
LOG_LEVEL=INFO

# S3/DigitalOcean Spaces Configuration
S3_ENABLED=true
S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=colytics-stage
S3_REGION=sfo3

# AI API Keys
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
