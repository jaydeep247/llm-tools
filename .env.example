# ====================================
# Contentlytics - Environment Configuration
# ====================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ====================================

# ====================================
# Server Configuration
# ====================================
PORT=3004
CORS_ORIGIN=http://localhost:3000

# ====================================
# Database Configuration (PostgreSQL)
# ====================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contentlytics
DB_USER=postgres
DB_PASSWORD=your_database_password

# ====================================
# Authentication & Security
# ====================================
# IMPORTANT: Change these secrets in production!
# Generate strong secrets with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# ====================================
# Email Configuration (SMTP)
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=your_email@gmail.com
MAIL_TO=recipient@example.com

# ====================================
# Google PageSpeed Insights API
# ====================================
# Get your key: https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=your_google_psi_api_key

# ====================================
# External Services
# ====================================
# Python AEO API Base URL
PY_API_BASE=http://localhost:8000

# ====================================
# Frontend Configuration (Vite)
# ====================================
# These are used by the React frontend
# In production, set these to your actual domain (e.g., https://yourdomain.com)
VITE_API_BASE_URL=http://localhost:3004
VITE_AEO_API_BASE_URL=http://localhost:8000
